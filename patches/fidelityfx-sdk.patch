 #
 # Returns
 # A list of header files generated by the FidelityFX Shader Compiler driver.
+# Preserve permutation braces on shells with brace expansion, and paths with
+# spaces/parentheses. execute_process passes argv directly to the compiler.
+function(ffx_shader_command OUTPUT_HEADER PASS_SHADER)
+    set(script "execute_process(COMMAND\n")
+    foreach(arg IN LISTS ARGN)
+        string(APPEND script "[==[${arg}]==]\n")
+    endforeach()
+    string(APPEND script "RESULT_VARIABLE shader_result)\nif(NOT shader_result EQUAL 0)\nmessage(FATAL_ERROR \"Shader compilation failed: \${shader_result}\")\nendif()\n")
+    set(script_path "${OUTPUT_HEADER}.cmake")
+    file(CONFIGURE OUTPUT "${script_path}" CONTENT "${script}" @ONLY)
+    if(UNIX)
+        # The bundled Windows compiler emits unescaped Wine Z: paths in its
+        # depfile. Track the GPU headers directly until it supports Unix paths.
+        file(GLOB_RECURSE shader_headers CONFIGURE_DEPENDS
+            "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/*.h"
+            "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/*.hlsli"
+            "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/*.glsl")
+        set(depfile_args)
+    else()
+        set(shader_headers)
+        set(depfile_args DEPFILE "${OUTPUT_HEADER}.d")
+    endif()
+    add_custom_command(OUTPUT "${OUTPUT_HEADER}"
+        COMMAND "${CMAKE_COMMAND}" -P "${script_path}"
+        DEPENDS "${PASS_SHADER}" "${script_path}" ${shader_headers}
+        ${depfile_args}
+        WORKING_DIRECTORY "${CMAKE_BINARY_DIR}"
+        VERBATIM)
+endfunction()
