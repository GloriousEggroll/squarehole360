#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0) uniform texture2D source_image;
layout(set=0,binding=1) uniform sampler source_sampler;
layout(set=0,binding=2,std430) writeonly buffer Result {uvec4 values[];} result;
void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=4096u)return;
    vec4 value=textureLod(sampler2D(source_image,source_sampler),vec2((float(i)+.5)/4096.0,.5),0);
    result.values[i]=floatBitsToUint(value);
}
