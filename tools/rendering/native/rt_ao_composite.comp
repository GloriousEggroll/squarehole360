#version 460
// Ray-traced ambient occlusion, step 4: upsamples and blurs the accumulated
// half-resolution occlusion, weighting each sample by how close its depth is
// to the pixel's, and multiplies it into the scene colour. Built once per
// storage format (OUT_FORMAT: rgba8, rgb10_a2 or rgba16f) to match the scene.
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D occlusion;     // half resolution; r: occlusion, g: frames
layout(set = 0, binding = 1) uniform texture2D depth_texture; // full resolution
layout(set = 0, binding = 2) uniform texture2D scene;
layout(set = 0, binding = 3, OUT_FORMAT) uniform writeonly image2D result;
layout(set = 0, binding = 4) uniform texture2D half_depth;    // depth of each occlusion sample

layout(push_constant, std430) uniform Push {
    uvec2 size;  // full resolution
    float strength;
    float sky_depth;
    uint debug_view;  // 1: show the occlusion only
    uint step;        // full-resolution pixels per occlusion texel
    float padding[2];
} p;

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(uvec2(pixel), p.size))) return;
    const vec4 color = texelFetch(scene, pixel, 0);
    const float depth = texelFetch(depth_texture, pixel, 0).r;
    float ao = 1.0;
    if (depth > p.sky_depth) {
        const ivec2 half_size = ivec2((p.size + p.step - 1u) / p.step);
        const vec2 centre = (vec2(pixel) + 0.5) / float(p.step) - 0.5;
        const ivec2 base = ivec2(floor(centre));
        // Wider while few frames have accumulated.
        const float frames = texelFetch(occlusion, clamp(base, ivec2(0), half_size - 1), 0).g;
        const int step = frames < 4.0 ? 2 : 1;
        float sum = 0.0, weight = 0.0, nearest = 1.0, nearest_difference = 1e30;
        for (int y = -2; y <= 3; ++y)
            for (int x = -2; x <= 3; ++x) {
                const ivec2 tap = clamp(base + ivec2(x, y) * step, ivec2(0), half_size - 1);
                const float d = texelFetch(half_depth, tap, 0).r;
                if (d <= p.sky_depth) continue;
                const float difference = abs(d - depth);
                const float value = texelFetch(occlusion, tap, 0).r;
                if (difference < nearest_difference) {nearest_difference = difference; nearest = value;}
                if (difference > 0.02 * depth) continue;
                const vec2 offset = vec2(tap) - centre;
                const float w = exp(-0.3 * dot(offset, offset) / float(step * step));
                sum += value * w;
                weight += w;
            }
        // No sample on this surface nearby (a thin object): the closest one.
        ao = weight > 1e-3 ? sum / weight : nearest;
    }
    // The colour is already tonemapped: the brightest pixels are mostly direct
    // light, glow and light shafts, which occlusion of ambient light hardly
    // affects.
    const float luminance = dot(clamp(color.rgb, 0.0, 1.0), vec3(0.2126, 0.7152, 0.0722));
    const float factor = mix(1.0, clamp(ao, 0.0, 1.0), p.strength * (1.0 - smoothstep(0.35, 0.85, luminance)));
    imageStore(result, pixel, p.debug_view != 0u ? vec4(vec3(factor), 1.0) : vec4(color.rgb * factor, color.a));
}
