add_executable(gow3-native-packed-secondary-stencil-clear-test "${CMAKE_CURRENT_LIST_DIR}/packed_secondary_stencil_clear_test.cpp")
target_compile_features(gow3-native-packed-secondary-stencil-clear-test PRIVATE cxx_std_20)
target_include_directories(gow3-native-packed-secondary-stencil-clear-test PRIVATE "${GOW3_ROOT}/src")
if(CMAKE_CXX_COMPILER_ID MATCHES "Clang" AND NOT CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
    target_compile_options(gow3-native-packed-secondary-stencil-clear-test PRIVATE -ffp-model=strict)
elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    target_compile_options(gow3-native-packed-secondary-stencil-clear-test PRIVATE -fno-fast-math -ffp-contract=off)
elseif(MSVC)
    target_compile_options(gow3-native-packed-secondary-stencil-clear-test PRIVATE /fp:strict)
endif()
