#if LOAD_COMPONENTS == 1
layout(set=0,binding=1,r32f) writeonly uniform image2D output_image;
#elif LOAD_COMPONENTS == 2
layout(set=0,binding=1,rg32f) writeonly uniform image2D output_image;
#else
layout(set=0,binding=1,rgba32f) writeonly uniform image2D output_image;
#endif
#endif
layout(push_constant) uniform Parameters {
    uvec2 extent;uvec2 origin;uvec2 packed_offset;uint pitch;uint log_bytes;
