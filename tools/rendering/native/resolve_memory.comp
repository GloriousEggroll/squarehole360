float decode8(uint v,uint channel) {
    if(((pc.signs>>(channel*2))&3)==1)return max(float(int(v<<24)>>24)/127.0,-1.0);
    return float(v)/255.0;
}
float decode16(uint v,uint channel) {
    if(((pc.signs>>(channel*2))&3)==1)return max(float(int(v<<16)>>16)/32767.0,-1.0);
