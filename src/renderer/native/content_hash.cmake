if(TARGET gow3-native-content-hash)
    return()
endif()
get_filename_component(GOW3_CONTENT_HASH_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
option(GOW3_NATIVE_ACCELERATED_HASH "Use OpenSSL's portable accelerated SHA-256 when available" ON)
if(GOW3_NATIVE_ACCELERATED_HASH)
    find_package(OpenSSL QUIET COMPONENTS Crypto)
endif()
add_library(gow3-native-content-hash INTERFACE)
target_include_directories(gow3-native-content-hash INTERFACE
    "${GOW3_CONTENT_HASH_ROOT}/src"
    "${GOW3_CONTENT_HASH_ROOT}/vendor/rexglue-sdk/thirdparty/picosha2")
if(GOW3_NATIVE_ACCELERATED_HASH AND TARGET OpenSSL::Crypto)
    target_compile_definitions(gow3-native-content-hash INTERFACE GOW3_NATIVE_USE_OPENSSL=1)
    target_link_libraries(gow3-native-content-hash INTERFACE OpenSSL::Crypto)
    message(STATUS "Native content hashing: OpenSSL SHA-256")
else()
    target_compile_definitions(gow3-native-content-hash INTERFACE GOW3_NATIVE_USE_OPENSSL=0)
    message(STATUS "Native content hashing: portable Picosha2 SHA-256")
endif()
