# Closed positive method-prefix allowlist for Clang22 LLVM IR PGO.
# Compiler proof showed allow matches win over overlapping forbid matches.
# Never reintroduce broad class allows plus exclusions. Unlisted methods,
# common template helpers, signals, MMIO and guest code are forbidden.
[llvm]
default:forbid

